CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# PSRAM de 8 MB del E1001 (Octal; si no se detecta, arranca sin ella).
# Sin test de memoria al arrancar: cada despertar lo repetiría.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# CONFIG_SPIRAM_MEMTEST is not set
# app_main: LittleFS, pintado, JSON de estado y WiFi en la misma pila
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Despertares más cortos: la CPU a 240 MHz acorta el handshake TLS (ECDHE/ECDSA
# por software en el S3), y SNTP pregunta en cuanto hay red en vez de esperar
# un retardo aleatorio de hasta 5 s.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set
